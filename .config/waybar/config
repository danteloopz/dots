{
    "layer": "top",
    "position": "top",
    "mod": "dock",
    "exclusive": true,
    "gtk-layer-shell": true,
    "height": 0,

    "modules-center": ["hyprland/workspaces"],
    "modules-right": ["tray", "pulseaudio", "network", "bluetooth", "clock"],
    
    "hyprland/language": {
        "format": "{}",
        "format-en": "ENG",
    },

// ====================================================

// ====================== System ======================

"pulseaudio": {
    "max-volume": 150,
    "scroll-step": 10,

    "format": "{icon}",
    "tooltip-format": "{icon}  {volume}%",
    
    "format-icons": {
    "headphone": " ",
      "format-muted": " ",
      "default": [" ", " "]
    },
    "on-click": "pavucontrol"
},

// ====================================================



// ====================== Workspaces ======================

"hyprland/workspaces": {

    "format":"{icon}",
    "icon-size": 32,
    "spacing": 16,
    
    "on-scroll-up": "hyprctl dispatch workspace r+1",
    "on-scroll-down": "hyprctl dispatch workspace r-1",
    
    "persistent-workspaces": { "*": 5 },
    "format-icons": {
        "urgent": "",
        //"active": "",
        //"default": "󰧞",
        "sort-by-number": true
        },
},

// ========================================================





// ====================== Utilities ======================

"tray": {
    "icon-size": 18,
    "spacing": 8
},

"clock": {
    "format": " {:%R}",
    "tooltip-format": " {:%d %B %Y}",
},


"network": {
    "format-wifi": "  {essid} ({signalStrength}%)",
    "format-ethernet": "{ipaddr}",
    "format-disconnected": "Disconnected",
    "tooltip-format": "{ifname} via {gwaddr}",
    "on-click": "foot --app-id=waybar-floating -e nmtui" 
},

"bluetooth": {
    "format": " {status}",
    "format-connected": " {device_alias}",
    "format-connected-battery": " {device_alias} {device_battery_percentage}%",
    
    // Hide the module entirely when no hardware controller is found
    "format-no-controller": "", 
    
    // Hide the module entirely when bluetooth is toggled off/disabled
    "format-disabled": "", 
    
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "on-click": "blueman-manager"
}



// =======================================================
}
